# Use the in-browser mock API (fixtures in src/services/mock/) instead of the real backend.
VITE_API_MOCK=false
# Base path of the JSON API (same origin by default).
VITE_API_BASE=/api/v1
# Backend origin the Vite dev server proxies /api, /download, /_dev-cdn, feeds and sitemap to.
VITE_DEV_PROXY_TARGET=http://localhost:8080
# Canonical public origin used for canonical URLs / OpenGraph / JSON-LD.
VITE_PUBLIC_ORIGIN=https://download.worksuitecloud.com
# Cloudflare Turnstile site key for the public "Report a problem" form (leave empty in development).
VITE_TURNSTILE_SITE_KEY=
